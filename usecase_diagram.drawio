<mxfile host="app.diagrams.net">
  <diagram name="Use Case Diagram" id="hostel-uc">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="750" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="boundary" value="Hostel Maintenance &amp; Issue Ticketing System" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="200" y="40" width="650" height="600" as="geometry" />
        </mxCell>

        <mxCell id="actorResident" value="Hostel Resident" style="shape=umlActor;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="30" height="60" as="geometry" />
        </mxCell>

        <mxCell id="actorWarden" value="Maintenance Warden" style="shape=umlActor;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="30" height="60" as="geometry" />
        </mxCell>

        <mxCell id="actorNotify" value="Notification System&#10;(external, secondary)" style="shape=umlActor;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1">
          <mxGeometry x="950" y="440" width="30" height="60" as="geometry" />
        </mxCell>

        <mxCell id="uc01" value="UC-01&#10;Log Maintenance Ticket" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#2f5496;" vertex="1" parent="1">
          <mxGeometry x="240" y="90" width="200" height="70" as="geometry" />
        </mxCell>

        <mxCell id="uc02" value="UC-02&#10;Attach Photo Evidence" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#2f5496;" vertex="1" parent="1">
          <mxGeometry x="240" y="200" width="200" height="70" as="geometry" />
        </mxCell>

        <mxCell id="uc03" value="UC-03&#10;Track Ticket Status" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#2f5496;" vertex="1" parent="1">
          <mxGeometry x="600" y="90" width="200" height="70" as="geometry" />
        </mxCell>

        <mxCell id="uc04" value="UC-04&#10;Close Ticket (Resident Sign-off)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#2f5496;" vertex="1" parent="1">
          <mxGeometry x="600" y="200" width="200" height="70" as="geometry" />
        </mxCell>

        <mxCell id="uc05" value="UC-05&#10;Assign Ticket to Staff" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2f7a3d;" vertex="1" parent="1">
          <mxGeometry x="240" y="330" width="200" height="70" as="geometry" />
        </mxCell>

        <mxCell id="uc06" value="UC-06&#10;Validate Staff Availability" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2f7a3d;" vertex="1" parent="1">
          <mxGeometry x="600" y="330" width="200" height="70" as="geometry" />
        </mxCell>

        <mxCell id="uc07" value="UC-07&#10;Monitor SLA &amp; Escalate Overdue Ticket" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#a06a00;" vertex="1" parent="1">
          <mxGeometry x="410" y="460" width="220" height="80" as="geometry" />
        </mxCell>

        <!-- Associations -->
        <mxCell id="e1" style="edgeStyle=none;html=1;endArrow=none;" edge="1" parent="1" source="actorResident" target="uc01"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=none;html=1;endArrow=none;" edge="1" parent="1" source="actorResident" target="uc03"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=none;html=1;endArrow=none;" edge="1" parent="1" source="actorResident" target="uc04"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=none;html=1;endArrow=none;" edge="1" parent="1" source="actorWarden" target="uc05"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=none;html=1;endArrow=none;" edge="1" parent="1" source="actorWarden" target="uc07"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="edgeStyle=none;html=1;endArrow=none;" edge="1" parent="1" source="actorNotify" target="uc07"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- include / extend -->
        <mxCell id="inc" value="&lt;&lt;include&gt;&gt;" style="edgeStyle=none;html=1;dashed=1;endArrow=open;fontStyle=2;" edge="1" parent="1" source="uc05" target="uc06"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ext" value="&lt;&lt;extend&gt;&gt;" style="edgeStyle=none;html=1;dashed=1;endArrow=open;fontStyle=2;" edge="1" parent="1" source="uc02" target="uc01"><mxGeometry relative="1" as="geometry"/></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
